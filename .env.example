# ===================================================================
# INELMEC Charger System — Environment Configuration
# ===================================================================
# Copy to .env and fill with real credentials for production.
# Defaults below are for local development against the mock providers.

# --- Server ---
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (SQLite for MVP; swap for PostgreSQL in production) ---
DB_PATH=./data/inelmec.db

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production-this-must-be-a-long-random-string
ADMIN_DEFAULT_EMAIL=admin@inelmec.com
ADMIN_DEFAULT_PASSWORD=inelmec2026

# --- Wompi (https://docs.wompi.co) ---
# Production: https://production.wompi.co/v1
# Sandbox:    https://sandbox.wompi.co/v1
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxx
# Used to validate the HMAC SHA-256 signature on incoming webhook events.
# Set in the Wompi dashboard under Eventos -> Configurar.
WOMPI_EVENTS_SECRET=test_events_secret_xxxxxxxxxxxxxxxx
# Used to sign the integrity hash sent on Checkout payment links.
WOMPI_INTEGRITY_SECRET=test_integrity_secret_xxxxxxxxxxxxxxxx

# --- Tuya IoT Cloud (https://iot.tuya.com) ---
# Pick the data center where the project was created. Common:
#   https://openapi.tuyaus.com   (Western America)
#   https://openapi.tuyaeu.com   (Central Europe — typical for LATAM)
#   https://openapi.tuyacn.com   (China)
TUYA_BASE_URL=https://openapi.tuyaus.com
TUYA_ACCESS_ID=your-tuya-access-id
TUYA_ACCESS_SECRET=your-tuya-access-secret

# Set TUYA_MOCK=true to use the in-memory device simulator instead of real
# Tuya Cloud calls. Useful for demos and integration testing without
# physical hardware. The mock honors all the timing characteristics
# (variable 1-15s activation latency) of the real platform.
TUYA_MOCK=true

# --- Activation orchestration tuning ---
# How often to poll Tuya device state after issuing an activate command.
ACTIVATION_POLL_INTERVAL_MS=500
# Hard timeout before we tell the user "activation failed, contact support".
ACTIVATION_TIMEOUT_MS=30000
# How frequently the safety worker scans for stuck-active chargers.
SAFETY_CHECK_INTERVAL_MS=15000
# Grace period after expected deactivation before we force shutdown.
SAFETY_GRACE_MS=10000
